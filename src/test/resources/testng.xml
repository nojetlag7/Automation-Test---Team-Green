<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MentorConnect" parallel="methods" thread-count="3" data-provider-thread-count="1">
  <test name="everyday">
    <groups>
      <run>
        <exclude name="registration"/>
      </run>
    </groups>
    <packages>
      <package name="org.teamgreen.mentorconnectautomation.ui"/>
      <package name="org.teamgreen.mentorconnectautomation.api"/>
    </packages>
  </test>
</suite>
